#!/usr/bin/env bash
#MISE description="Docker engine via get.docker.com, docker group, docker-model-plugin"
# serializes with flatpak: both run apt-get, and dpkg holds a global lock
# while mise runs tasks in parallel (apt holds a single global lock)
#MISE depends=["linux:apt-base", "linux:flatpak"]
set -euo pipefail

curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
chmod 0750 /tmp/get-docker.sh
(cd /tmp && sudo ./get-docker.sh)
rm -f /tmp/get-docker.sh
sudo groupadd -f docker
sudo usermod --append --groups docker "$(id -un)"
sudo apt-get update
sudo apt-get install -y docker-model-plugin
