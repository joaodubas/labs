#!/usr/bin/env bash
#MISE description="Build git allowed_signers from ~/.ssh/*.pub keys"
#MISE depends=["git:includes"]
# Build ~/.config/git/allowed_signers from the local SSH public keys.
# Idempotent: the file is fully rewritten on every run.
# Missing keys (fresh machine) are a warn-and-skip, not a hard failure:
# signature verification just won't work until the keys exist and bootstrap
# is re-run.
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/git"
gitea_pub="$HOME/.ssh/gitea.pub"
github_pub="$HOME/.ssh/github.pub"

missing=0
for key in "$gitea_pub" "$github_pub"; do
  if [[ ! -f "$key" ]]; then
    echo "warning: SSH public key not found: $key" >&2
    missing=1
  fi
done
if [[ "$missing" -eq 1 ]]; then
  echo "warning: skipping git allowed_signers generation; create the keys and re-run bootstrap" >&2
  exit 0
fi

mkdir -p "$config_dir"
{
  echo "joao.dubas+gitea@gmail.com namespaces=\"git\" $(cat "$gitea_pub")"
  echo "joao.dubas@gmail.com namespaces=\"git\" $(cat "$github_pub")"
  echo "joao.dubas@stord.com namespaces=\"git\" $(cat "$github_pub")"
} > "$config_dir/allowed_signers"

echo "wrote $config_dir/allowed_signers"
