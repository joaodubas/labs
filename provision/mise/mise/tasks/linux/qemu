#!/usr/bin/env bash
#MISE description="QEMU/KVM and libvirt tooling for the provision VM playground (provision/vm/vm.sh) and uncloud lab (provision/uncloud)"
#MISE depends=["linux:apt-base"]
#MISE wait_for=["linux:cuda-wsl"]
# dpkg-lock serialization: qemu needs only apt-base's *result* (depends);
# cuda-wsl is wait_for — qemu must not overlap its apt/dpkg runs (single
# global dpkg lock) but never consumes its output (cuda-wsl self-skips
# outside WSL).
set -euo pipefail

sudo apt-get install -y \
  qemu-system-x86 \
  qemu-utils \
  cloud-image-utils \
  libvirt-daemon-system \
  libvirt-clients \
  bridge-utils \
  libnss3-tools

# group membership applies to new login sessions; vm.sh falls back to `sg kvm`
for grp in kvm libvirt; do
  if ! id -nG "$(id -un)" | grep -qw "$grp"; then
    sudo usermod -aG "$grp" "$(id -un)"
    echo "added to $grp group — re-login (or use sg $grp) for it to apply"
  fi
done
