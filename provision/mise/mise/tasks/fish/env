#!/usr/bin/env bash
#MISE description="Set fish universal variables, PATH entries and abbreviations"
#MISE depends=["fish:config", "tools:cli"]
# Set fish universal variables, universal PATH entries and abbreviations.
# Shared block runs on both OSes; OS-specific extras are guarded by uname.
# Idempotent: `set -Ux`/`fish_add_path`/`abbr --add` converge to the same state.
#
# NOTE: the former ATUIN_BIN universal variable (and its PATH entry) was
# dropped on purpose: atuin is now a mise tool (Phase 2, migration plan §7.2).
set -euo pipefail

fish_bin="$(command -v fish || true)"
if [[ -z "$fish_bin" && -x /opt/homebrew/bin/fish ]]; then
  fish_bin=/opt/homebrew/bin/fish
fi
if [[ -z "$fish_bin" ]]; then
  echo "error: fish not found; install it first (apt on Linux, brew on macOS)" >&2
  exit 1
fi

# Shared universal variables
"$fish_bin" -c "set -Ux LOCAL_BIN_HOME $HOME/.local/bin"
"$fish_bin" -c "set -Ux LOCAL_SRC_HOME $HOME/.local/src"
"$fish_bin" -c "set -Ux XDG_CONFIG_HOME $HOME/.config"
"$fish_bin" -c "set -Ux XDG_DATA_HOME $HOME/.local/share"
"$fish_bin" -c "set -Ux XDG_CACHE_HOME $HOME/.cache"
"$fish_bin" -c "set -Ux STARSHIP_CONFIG $HOME/.config/starship/config.toml"
"$fish_bin" -c "set -Ux MISE_ENV_FILE .env"
"$fish_bin" -c "set -Ux EDITOR nvim"
"$fish_bin" -c "set -U fish_key_bindings fish_vi_key_bindings"

case "$(uname -s)" in
  Linux)
    "$fish_bin" -c "set -Ux COMPOSE_BAKE true"
    "$fish_bin" -c "fish_add_path -p -U -m -v $HOME/.local/bin"
    "$fish_bin" -c "abbr --add wezterm flatpak run org.wezfurlong.wezterm"
    ;;
  Darwin)
    "$fish_bin" -c "fish_add_path -p -U -m -v /opt/homebrew/bin"
    "$fish_bin" -c "fish_add_path -p -U -m -v /opt/homebrew/sbin"
    "$fish_bin" -c "fish_add_path -p -U -m -v $HOME/.local/bin"
    "$fish_bin" -c "fish_add_path -p -U -m -v $HOME/.local/share/mise/shims"
    ;;
  *)
    echo "error: unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac
